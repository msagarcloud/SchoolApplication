    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.Hosting.WindowsServices" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SchoolDemo.Application\SchoolDemo.Application.csproj" />
    <ProjectReference Include="..\SchoolDemo.Infrastructure\SchoolDemo.Infrastructure.csproj" />
  </ItemGroup>

